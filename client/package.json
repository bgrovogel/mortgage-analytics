{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "e2e": "playwright test --project=chromium",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:cross": "playwright test --project=firefox --project=webkit --workers=2",
    "e2e:cross:install": "playwright install firefox webkit",
    "test": "jest",
    "test:watch": "jest --watch --coverage=false",
    "lint": "ng lint",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json",
    "mutation": "stryker run",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/jest": "^30.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "vite": "8.3.4",
    "qs": "6.16.1"
  }
}
