<Project>
  <!-- Shared settings for every project in the solution (DRY). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!--
    Production code must document its public surface: a missing XML summary (CS1591) fails the
    build. The same comments feed Swagger and IntelliSense. Test projects are exempt because
    their method names are the documentation.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
