<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Enforces the team's test-writing standards by parsing every test file with Roslyn.
    A violation fails the build in CI, the same as a failing test.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
