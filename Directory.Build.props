<Project>
  <!-- Shared settings for every project in the solution (DRY). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- packages.lock.json pins every package, transitive ones included, like package-lock.json does for npm.
         CI and Docker restore in locked mode, and CI caches packages keyed on these files. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    Production code must document its public surface: a missing XML summary (CS1591) fails the
    build. The same comments feed Swagger and IntelliSense. Test projects are exempt because
    their method names are the documentation.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
